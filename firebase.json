{
  "hosting": {
    "target": "play",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*"],
    "trailingSlash": true,
    "redirects": [
      { "source": "/", "destination": "/signal/", "type": 302 }
    ],
    "headers": [
      {
        "source": "**/assets/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "regex": "^/([^/]+/)?(index\\.html)?$",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
